# MarketMind-API Environment Configuration

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=MarketMind-API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# API Security
REQUIRE_API_KEY=False
API_KEY=your_marketmind_api_key_here

# Google AI Studio (Gemini)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Database Configuration (Serverless PostgreSQL: Neon.tech or Supabase)
# Example: postgresql+asyncpg://user:password@ep-cool-pool-12345.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketmind

# Search Configuration
# SEARCH_PROVIDER options: duckduckgo (free, no key needed), serper, brave
SEARCH_PROVIDER=duckduckgo
SERPER_API_KEY=your_serper_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
TAVILY_API_KEY=

# Market Dashboard Configuration
DASHBOARD_ENABLED=True
DASHBOARD_CACHE_TTL_HOURS=1.0
