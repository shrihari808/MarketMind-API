# MarketMind-API Environment Configuration

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=MarketMind-API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# API Security
REQUIRE_API_KEY=False
API_KEY=your_marketmind_api_key_here

# Google AI Studio (Gemini)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
EMBEDDING_BATCH_SIZE=32

# Database Configuration (Serverless PostgreSQL: Neon.tech or Supabase)
# Example: postgresql+asyncpg://user:password@ep-cool-pool-12345.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketmind

# Search & Retrieval Configuration
# SEARCH_PROVIDER options: duckduckgo (free, no key needed), serper, brave
SEARCH_PROVIDER=duckduckgo
# SEARCH_TIMELIMIT options: 'd' (past 24h), 'w' (past week), 'm' (past month), 'y' (past year), or leave empty for all-time
SEARCH_TIMELIMIT=w
MAX_SEARCH_CANDIDATES=15
MAX_SEARCH_RESULTS=7
MAX_SCRAPED_SOURCES=5
RAG_HALF_LIFE_DAYS=7.0
RAG_RELEVANCE_FLOOR=0.25
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50
SERPER_API_KEY=your_serper_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
TAVILY_API_KEY=

# Market Dashboard Configuration
DASHBOARD_ENABLED=True
DASHBOARD_CACHE_TTL_HOURS=1.0

# Deep Equity Research Configuration
RESEARCH_SECTION_BY_SECTION=False

# Rate Limiting Configuration (Per Client IP)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=25
