# Ignore frontend source and build artifacts (hosted independently on Vercel)
frontend/
node_modules/

# Ignore version control and CI
.git/
.github/
.gitignore

# Ignore Python virtual environment and caches
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Ignore local scratch scripts, tests, and temporary data
scratch/
tests/
v1/
data/
*.sqlite
*.db

# Ignore environment files
.env
.env.*

# Ignore docs and metadata not needed in production container
dev_checklist.md
*.log
